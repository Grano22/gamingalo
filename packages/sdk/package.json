{
  "name": "@gamingalo/sdk",
  "version": "0.14.1",
  "description": "Gamingalo SDK for game makers",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://grano22.github.io/gamingalo/docs/sdk",
  "bugs": {
    "url": "https://github.com/Grano22/gamingalo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grano22/gamingalo.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "changelogs",
    "dist"
  ],
  "scripts": {
    "build": "vite build && node scripts/check-size.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint ."
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@gamingalo/errors": "*"
  }
}
