{
  "name": "@gamingalo/cli",
  "version": "0.2.0",
  "description": "Publish and manage Gamingalo games",
  "type": "module",
  "bin": {
    "gamingalo": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && node scripts/copy-schemas.mjs && chmod +x dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gamingalo/api": "*",
    "@gamingalo/contracts": "*",
    "@types/node": "^24.0.0"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/schemas"
        ]
      }
    }
  }
}
