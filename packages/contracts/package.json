{
  "name": "@gamingalo/contracts",
  "version": "0.3.0",
  "description": "API request and response schemas shared by Gamingalo services and clients",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gamingalo.schema.json": "./dist/gamingalo.schema.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && node scripts/generate-schemas.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
